{
  "name": "pystructure-vscode",
  "displayName": "PyStructure",
  "description": "VS Code extension scaffold for the PyStructure analyzer.",
  "version": "0.3.0",
  "publisher": "pystructure",
  "repository": {
    "type": "git",
    "url": "https://github.com/NazonoKansatugata/PyStructure.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:pystructure.analyzeWorkspace",
    "onView:pystructureResults"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "pystructureResults",
          "name": "PyStructure Results"
        }
      ]
    },
    "commands": [
      {
        "command": "pystructure.analyzeWorkspace",
        "title": "PyStructure: Analyze Workspace"
      },
      {
        "command": "pystructure.exportAdviceMarkdown",
        "title": "PyStructure: Export Advice as Markdown",
        "icon": "$(save)"
      },
      {
        "command": "pystructure.highlightAdvice",
        "title": "PyStructure: Highlight Advice Targets in Graph"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pystructure.exportAdviceMarkdown",
          "when": "view == pystructureResults",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "pystructure.highlightAdvice",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "prepare-assets": "node scripts/copy-assets.js",
    "compile": "npm run prepare-assets && tsc -p .",
    "watch": "npm run prepare-assets && tsc -watch -p .",
    "lint": "tsc -p . --noEmit",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3",
    "@vscode/vsce": "^3.2.2"
  }
}
