{
  "name": "pystructure-vscode",
  "displayName": "PyStructure",
  "description": "VS Code extension scaffold for the PyStructure analyzer.",
  "version": "0.1.0",
  "publisher": "pystructure",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:pystructure.analyzeWorkspace",
    "onCommand:pystructure.showGraph",
    "onView:pystructureResults"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "pystructureResults",
          "name": "PyStructure Results"
        }
      ]
    },
    "commands": [
      {
        "command": "pystructure.analyzeWorkspace",
        "title": "PyStructure: Analyze Workspace"
      },
      {
        "command": "pystructure.showGraph",
        "title": "PyStructure: Show Dependency Graph"
      }
    ]
  },
  "scripts": {
    "copy-webview": "node scripts/copy-webview.js",
    "compile": "npm run copy-webview && tsc -p .",
    "watch": "npm run copy-webview && tsc -watch -p .",
    "lint": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3"
  }
}
